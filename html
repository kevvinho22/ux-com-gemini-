    <!-- JAVASCRIPT DE ACESSIBILIDADE E INTERAÇÃO -->
    <script>
        // Inicializa os ícones Lucide
        lucide.createIcons();

        // 1. Data Atual Formatada em Português
        const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const today = new Date().toLocaleDateString('pt-BR', dateOptions);
        document.getElementById('currentDate').textContent = today.charAt(0).toUpperCase() + today.slice(1);

        // 2. Aumentar e Diminuir a Fonte
        let currentFontScale = 100;
        function changeFontSize(delta) {
            currentFontScale += delta * 15;
            // Limites de segurança para tamanho da fonte (80% até 160%)
            if (currentFontScale < 80) currentFontScale = 80;
            if (currentFontScale > 160) currentFontScale = 160;
            
            document.documentElement.style.fontSize = currentFontScale + '%';
        }

        // 3. Modos de Alto Contraste
        function toggleContrast() {
            document.body.classList.toggle('high-contrast');
        }

        // 4. Leitura em Voz Alta (SpeechSynthesis API)
        let isSpeaking = false;
        
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // Para qualquer leitura anterior
                
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'pt-BR';
                utterance.rate = 0.9; // Velocidade ligeiramente reduzida para clareza
                
                utterance.onend = function() {
                    isSpeaking = false;
                    updateReadButtonState();
                };

                window.speechSynthesis.speak(utterance);
                isSpeaking = true;
                updateReadButtonState();
            } else {
                alert("Seu navegador não suporta a leitura em voz alta.");
            }
        }

        function readPageAloud() {
            if (isSpeaking) {
                window.speechSynthesis.cancel();
                isSpeaking = false;
                updateReadButtonState();
            } else {
                const mainContent = document.getElementById('main-content').innerText;
                speakText("Iniciando leitura da tela. " + mainContent);
            }
        }

        function updateReadButtonState() {
            const btnText = document.getElementById('readStatusText');
            if (isSpeaking) {
                btnText.textContent = "Parar Leitura";
            } else {
                btnText.textContent = "Ouvir Tela";
            }
        }

        // 5. Funções para Abrir e Fechar o Modal de Emergência
        function openEmergencyModal() {
            const modal = document.getElementById('emergencyModal');
            modal.classList.remove('hidden');
            // Anuncia a abertura para leitores de tela e voz alta
            speakText("Modal de emergência aberto. Opções disponíveis: Polícia 190, Bombeiros 193 e WhatsApp de Confiança.");
        }

        function closeEmergencyModal() {
            const modal = document.getElementById('emergencyModal');
            modal.classList.add('hidden');
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        }

        // Fechar modal ao pressionar a tecla ESC
        window.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeEmergencyModal();
            }
        });
